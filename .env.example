# Create a Telegram bot with @BotFather, then set its token locally. Never commit a real token.
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token

# PostgreSQL is used for durable alerts, loads, and notification delivery state.
DATABASE_URL=postgresql://haulalert:replace-with-password@localhost:5432/haulalert

# Durable notification worker tuning.
NOTIFICATION_WORKER_BATCH_SIZE=25
NOTIFICATION_WORKER_POLL_INTERVAL_MS=1000
NOTIFICATION_WORKER_MAXIMUM_ATTEMPTS=3
NOTIFICATION_WORKER_INITIAL_RETRY_DELAY_MS=5000
