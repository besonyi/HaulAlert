# Create a Telegram bot with @BotFather, then set its token locally. Never commit a real token.
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token

# A secret of at least 16 random characters, configured in Telegram setWebhook as secret_token.
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret

# The public endpoint configured in Telegram setWebhook, and the port exposed by this service.
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
PORT=3000

# Authenticated Mini App API port. The Mini App sends Telegram.WebApp.initData as Authorization: tma <initData>.
API_PORT=3001

# Mini App development server. It proxies /api to the API, keeping Telegram authorization same-origin.
MINIAPP_PORT=3002
MINIAPP_API_ORIGIN=http://127.0.0.1:3001

# PostgreSQL is used for durable alerts, loads, and notification delivery state.
DATABASE_URL=postgresql://haulalert:replace-with-password@localhost:5432/haulalert

# Durable notification worker tuning.
NOTIFICATION_WORKER_BATCH_SIZE=25
NOTIFICATION_WORKER_POLL_INTERVAL_MS=1000
NOTIFICATION_WORKER_MAXIMUM_ATTEMPTS=3
NOTIFICATION_WORKER_INITIAL_RETRY_DELAY_MS=5000
NOTIFICATION_WORKER_CLAIM_LEASE_DURATION_MS=300000
