{
  "name": "haulalert",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram-first new-load alert service for vehicle transport",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @haulalert/shared run build",
    "lint": "pnpm --filter @haulalert/shared --if-present run lint",
    "typecheck": "pnpm --filter @haulalert/shared run typecheck",
    "test": "pnpm --filter @haulalert/shared --if-present run test",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
