{
  "name": "@haulalert/browser-runtime-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "node --test dist/*.test.js",
    "start:central-dispatch": "node dist/central-dispatch-worker-main.js",
    "check:central-dispatch": "node dist/central-dispatch-readiness-main.js"
  },
  "dependencies": {
    "@haulalert/adapter-central-dispatch": "workspace:*",
    "@haulalert/adapter-shipcars": "workspace:*",
    "@haulalert/adapter-super-dispatch": "workspace:*",
    "@haulalert/browser-runtime-core": "workspace:*",
    "@haulalert/filter-compiler": "workspace:*",
    "@haulalert/ingestion-service": "workspace:*",
    "@haulalert/load-model": "workspace:*",
    "@haulalert/matcher-service": "workspace:*",
    "@haulalert/new-load-detector": "workspace:*",
    "@haulalert/notification-service": "workspace:*",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
